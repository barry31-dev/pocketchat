{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketChat TaskPlan v1",
  "description": "A closed, non-executable plan bound to one TaskSpec; every action and input is revalidated against the spec. run_command names only a declared template id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_sha256",
    "steps",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": "pocketchat-task-plan.v1"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objective",
        "action",
        "inputs",
        "expected_evidence",
        "depends_on",
        "retry_limit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "action": {
          "enum": [
            "read_file",
            "write_file",
            "memory_search",
            "run_command"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "expected_evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "retry_limit": {
          "const": 0
        }
      }
    }
  }
}
