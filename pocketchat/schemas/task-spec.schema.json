{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketChat TaskSpec v1",
  "description": "Closed operator-authorized task specification. Read-only preview converts it to pocketchat-task-policy.v1; overwrite_paths names existing files that a separate guarded editor may replace; commands are closed argv templates executed without a shell.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "workspace_root",
    "inputs",
    "budgets",
    "tools",
    "commands",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "pocketchat-task-spec.v1"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overwrite_paths": {
      "type": "array",
      "description": "Existing UTF-8 files that a separate guarded editor may replace; each must also be in inputs and tools.write_file.allow_paths.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "max_tool_calls",
        "max_context_chars",
        "max_turn_tokens"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_context_chars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400000
        },
        "max_turn_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        },
        "max_session_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        },
        "max_task_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000000
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read_file": {
          "$ref": "#/$defs/tool_grant"
        },
        "write_file": {
          "$ref": "#/$defs/tool_grant"
        },
        "memory_search": {
          "$ref": "#/$defs/tool_grant"
        }
      }
    },
    "commands": {
      "type": "array",
      "description": "Closed argv command templates. TaskPlan steps may only reference an id; shell executables and shell strings are refused.",
      "items": {
        "$ref": "#/$defs/command_template"
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "tool_grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "create_only": {
          "const": true
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "command_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1048576
        }
      }
    }
  }
}
